---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="页面不存在" description="这一页不在册子里。">
  <div class="container">
    <section class="error-page">
      <p class="kicker">404</p>
      <h1>这一页不在册子里。</h1>
      <p>可能已经移动，或者从来没有存在过。</p>
      <a class="back-link" href="/">← 回到作品索引</a>
    </section>
  </div>
</BaseLayout>
